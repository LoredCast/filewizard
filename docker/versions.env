# Pins for software that comes from neither Ubuntu nor PyPI. scripts/update-deps.sh writes this
# file; the image build reads it (docker/install-system-packages.sh).
#
# Calibre: empty CALIBRE_VERSION installs Ubuntu's calibre package (7.6.0 on 24.04, with Qt
# WebEngine 6.4). A version installs the official build from the Calibre GitHub releases, which
# bundles a current Qt, after checking it against these SHA-256 checksums.
CALIBRE_VERSION=9.18.0
CALIBRE_SHA256_X86_64=da638166fb3dd204be77cf0f871a40d803536b3e5948969c5233b8e4f1e1dbe6
CALIBRE_SHA256_ARM64=7f29f1786dcfc5b6f3b6d29b245998a6701501169fbd4c853f17c35d3a635e91
